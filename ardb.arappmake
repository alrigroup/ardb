ALRIGROUP@APPMAKE
{
  "name": "ardb",
  "bin": "ardb.arapp",
  "version": "0.2.02",
  "runtime": "native",
  "entry": "ardb",
  "platforms": {
    "windows": {
      "entry": "ardb"
    },
    "linux": {
      "entry": "ardb"
    },
    "linux-x64": {
      "entry": "ardb"
    },
    "linux-arm64": {
      "entry": "ardb"
    }
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -Isrc -I$ARCORE/include -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -I../../ALRIOS/arkernel/ipc -o $STAGING/ardb src/ardb_entry.c src/ardb_config.c src/ardb_http.c src/ardb_pgwire.c src/ardb_storage_engine.c src/ardb_backend.c src/ardb_auth.c src/ardb_firewall.c src/ardb_audit.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "ardb",
    "ardb.cfg"
  ],
  "description": "Guardiao de Banco de Dados Soberano e Firewall SQL",
  "commands": [
    "status",
    "auth login",
    "user add",
    "app add",
    "group create",
    "audit verify"
  ]
}
